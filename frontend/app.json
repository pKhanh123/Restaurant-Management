        "foregroundImage": "./assets/brand/crispy-bite-app-icon-1024.png",
        "backgroundColor": "#D92D20"
      }
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/brand/crispy-bite-favicon-64.png"
    }
  }
}
