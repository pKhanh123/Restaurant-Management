  vatAmount               Int                  @default(0)
  refundAmount            Int                  @default(0)
  refundMethod            String               @default("CASH") @db.VarChar(20)
  financialAccountId      Int?
  refundExternalReference String?              @unique @db.VarChar(120)
  note                    String?              @db.VarChar(1000)
  createdByUserId         Int?
  createdByName           String?              @db.VarChar(120)
  completedByUserId       Int?
  completedAt             DateTime?
  cancelledByUserId       Int?
  cancelledAt             DateTime?
  createdAt               DateTime             @default(now())
  updatedAt               DateTime             @updatedAt

  supplier              Supplier?              @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  sourceReceipt         PurchaseReceipt?       @relation(fields: [sourceReceiptId], references: [id], onDelete: Restrict)
  lines                 PurchaseReturnLine[]
  inventoryTransactions InventoryTransaction[]
  financialAccount      FinancialAccount?      @relation(fields: [financialAccountId], references: [id], onDelete: Restrict)

  @@index([status, returnedAt])
  @@index([supplierId, returnedAt])
  @@index([sourceReceiptId])
  @@index([financialAccountId, completedAt])
}

model PurchaseReturnLine {
  id                  Int                  @id @default(autoincrement())
  purchaseReturnId    Int
  ingredientId        Int
  sourceReceiptLineId Int?
  ingredientSku       String
  ingredientName      String
  unit                String
  quantity            Float
  purchaseUnitCost    Int
  returnUnitPrice     Int
  lineAmount          Int
  stockCostPerUnit    Int                  @default(0)
  stockCostAmount     Int                  @default(0)
  purchaseReturn      PurchaseReturn       @relation(fields: [purchaseReturnId], references: [id], onDelete: Cascade)
  ingredient          Ingredient           @relation(fields: [ingredientId], references: [id], onDelete: Restrict)
  sourceReceiptLine   PurchaseReceiptLine? @relation(fields: [sourceReceiptLineId], references: [id], onDelete: Restrict)

  @@unique([purchaseReturnId, ingredientId])
  @@index([ingredientId])
  @@index([sourceReceiptLineId])
}
