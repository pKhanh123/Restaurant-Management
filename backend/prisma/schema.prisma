// backend/prisma/schema.prisma
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  CASHIER
  KITCHEN
  ADMIN
}

enum OrderItemCancellationSource {
  ORDER_VOID
  ITEM_CANCEL
}

enum CancellationPreparationState {
  NOT_STARTED
  PREPARING
  READY
  UNKNOWN
}

enum CancellationInventoryEffect {
  NONE
  RESTORED
  WASTE_RECORDED
}

enum EmployeeStatus {
  WORKING
  RESIGNED
}

enum EmployeeGender {
  MALE
  FEMALE
  OTHER
}

enum EmployeePayBasis {
  MONTHLY
  HOURLY
  PER_SHIFT
}

enum EmployeeAttendanceMode {
  SHIFT
}

enum EmployeePayrollFrequency {
  MONTHLY
}

enum EmployeePayrollHourlySource {
  ACTUAL_ATTENDANCE
}

enum PayrollFrequency {
  MONTHLY
}

enum PayrollBatchStatus {
  DRAFT
  CALCULATED
  FINALIZED
  CANCELLED
}

enum PayrollCalculationStatus {
  READY
  REVIEW_REQUIRED
}

enum PayrollAdjustmentType {
  BONUS
  DEDUCTION
}

enum PayrollPaymentMethod {
  CASH
  BANK_TRANSFER
  OTHER
}

enum PayrollPaymentStatus {
  SUCCESS
  REVERSED
}

enum CommissionPlanStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum CommissionRuleType {
  FIXED_PER_UNIT
  PERCENT_NET_REVENUE
  PERCENT_GROSS_PROFIT
}

enum CommissionCostStatus {
  CAPTURED
  MISSING
}

enum CommissionBasisResolutionType {
  COST_OVERRIDE
  RULE_OVERRIDE
}

enum CommissionRecognitionIssueType {
  UNASSIGNED_EMPLOYEE
  PLAN_MISSING
  PLAN_CONFLICT
  RULE_MISSING
  RULE_CONFLICT
  COST_MISSING
  LEDGER_CONFLICT
}

enum CommissionRecognitionIssueStatus {
  OPEN
  RESOLVED
}

enum CommissionEntryType {
  EARNING
  RETURN_REVERSAL
  REASSIGNMENT_REVERSAL
  REASSIGNMENT_EARNING
}

enum CommissionPayrollAllocationEventType {
  RESERVED
  FINALIZED
  RELEASED
}

enum ScheduleRecurrenceType {
  ONCE
  WEEKLY
}

enum ScheduleExceptionType {
  CANCELLED
}

enum AttendancePunchSource {
  KIOSK
  ADMIN_MANUAL
}

enum AttendanceScheduleLinkStatus {
  SCHEDULED
  UNSCHEDULED
  NEEDS_REVIEW
}

enum AttendanceDispositionType {
  ABSENT
}

enum AttendanceRateLimitBucketType {
  KIOSK_SESSION
  ATTENDANCE_CODE
  IP_ADDRESS
}

enum OrderType {
  DINE_IN
  TAKE_AWAY
  DELIVERY
}

enum DeliveryPartnerType {
  INDIVIDUAL
  COMPANY
}

enum OrderStatus {
  PENDING
  PREPARING
  READY
  COMPLETED
  CANCELLED
}

enum TableStatus {
  AVAILABLE
  OCCUPIED
  DIRTY
  NEED_CLEANING
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  CREDIT_CARD
  E_WALLET
}

enum FinancialAccountType {
  CASH
  BANK
  E_WALLET
}

enum CashVoucherDirection {
  RECEIPT
  PAYMENT
}

enum CashVoucherStatus {
  POSTED
  CANCELLED
}

enum CashVoucherSourceType {
  MANUAL
  RESERVATION_DEPOSIT
  RESERVATION_REFUND
  ORDER_PAYMENT
  SALES_RETURN_REFUND
  PURCHASE_RECEIPT_PAYMENT
  SUPPLIER_PAYMENT
  PURCHASE_RETURN_REFUND
  PAYROLL_PAYMENT
  REVERSAL
}

enum PaymentStatus {
  UNPAID
  WAITING_CONFIRMATION
  PAID
  VOIDED
}

enum OrderPaymentTransactionStatus {
  PENDING
  SUCCESS
  REJECTED
}

enum MenuType {
  FOOD
  DRINK
  SERVICE
  OTHER
}

enum MenuItemType {
  REGULAR
  TOPPING
  COMBO
  SERVICE
}

enum DiscountType {
  PERCENTAGE
  FIXED_AMOUNT
}

enum OrderReturnStatus {
  COMPLETED
  CANCELLED
}

enum PriceListType {
  GENERAL
  CUSTOM
}

enum PriceListScopeType {
  GLOBAL
  BRANCH
  CHANNEL
  CUSTOMER_GROUP
}

enum CustomerType {
  INDIVIDUAL
  COMPANY
}

enum CustomerGender {
  MALE
  FEMALE
  OTHER
}

enum ReservationStatus {
  PENDING_DEPOSIT
  CONFIRMED
  CHECKED_IN
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum DepositStatus {
  UNPAID
  WAITING_CONFIRMATION
  PAID
  REFUND_PENDING
  REFUNDED
  FORFEITED
  APPLIED_TO_BILL
}

enum ReservationDepositTransactionType {
  DEPOSIT
  REFUND
  PARTIAL_REFUND
  FORFEIT
  APPLY_TO_BILL
}

enum ReservationDepositTransactionStatus {
  PENDING
  SUCCESS
  REJECTED
}

model User {
  id           Int      @id @default(autoincrement())
  username     String   @unique
  passwordHash String
  name         String
  role         Role     @default(CASHIER)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  createdOrders                     Order[]                         @relation("CreatedOrders")
  voidedOrders                      Order[]                         @relation("VoidedOrders")
  auditLogs                         AuditLog[]                      @relation("AuditLogs")
  confirmedOrderPaymentTransactions OrderPaymentTransaction[]       @relation("OrderPaymentConfirmer")
  employeeProfile                   Employee?
  createdEmployeeCompensations      EmployeeCompensation[]          @relation("EmployeeCompensationCreator")
  createdWorkShifts                 WorkShift[]                     @relation("WorkShiftCreator")
  createdEmployeeScheduleRules      EmployeeScheduleRule[]          @relation("EmployeeScheduleRuleCreator")
  cancelledEmployeeScheduleRules    EmployeeScheduleRule[]          @relation("EmployeeScheduleRuleCanceller")
  createdEmployeeScheduleExceptions EmployeeScheduleException[]     @relation("EmployeeScheduleExceptionCreator")
  createdAttendanceKioskSessions    AttendanceKioskSession[]        @relation("AttendanceKioskSessionCreator")
  createdAttendanceDispositions     EmployeeAttendanceDisposition[] @relation("AttendanceDispositionCreator")
  revokedAttendanceDispositions     EmployeeAttendanceDisposition[] @relation("AttendanceDispositionRevoker")
  createdPayrollBatches             EmployeePayrollBatch[]          @relation("EmployeePayrollBatchCreator")
  calculatedPayrollBatches          EmployeePayrollBatch[]          @relation("EmployeePayrollBatchCalculator")
  finalizedPayrollBatches           EmployeePayrollBatch[]          @relation("EmployeePayrollBatchFinalizer")
  cancelledPayrollBatches           EmployeePayrollBatch[]          @relation("EmployeePayrollBatchCanceller")
  createdPayrollAdjustments         EmployeePayrollAdjustment[]     @relation("EmployeePayrollAdjustmentCreator")
  reversedPayrollAdjustments        EmployeePayrollAdjustment[]     @relation("EmployeePayrollAdjustmentReverser")
  createdPayrollPayments            EmployeePayrollPayment[]        @relation("EmployeePayrollPaymentCreator")
  reversedPayrollPayments           EmployeePayrollPayment[]        @relation("EmployeePayrollPaymentReverser")
  payrollIdempotencies              EmployeePayrollIdempotency[]
  createdAttendancePolicies         BranchAttendancePolicyVersion[] @relation("AttendancePolicyCreator")
  createdPayrollPolicies            BranchPayrollPolicyVersion[]    @relation("PayrollPolicyCreator")
  createdWorkweekPolicies           BranchWorkweekPolicyVersion[]   @relation("WorkweekPolicyCreator")
  createdHolidayPeriods             BranchHolidayPeriod[]           @relation("HolidayPeriodCreator")
  archivedHolidayPeriods            BranchHolidayPeriod[]           @relation("HolidayPeriodArchiver")
  scheduleIdempotencies             EmployeeScheduleIdempotency[]
  createdCashVouchers               CashVoucher[]                   @relation("CashVoucherCreator")
  handledCashVouchers               CashVoucher[]                   @relation("CashVoucherHandler")
  cancelledCashVouchers             CashVoucher[]                   @relation("CashVoucherCanceller")
  activatedCashbooks                CashbookSetting[]               @relation("CashbookActivator")
  orderItemCancellations            OrderItemCancellation[]         @relation("OrderItemCancellationActor")
}

model Branch {
  id        Int      @id @default(autoincrement())
  code      String   @unique @db.VarChar(40)
  name      String   @db.VarChar(120)
  isActive  Boolean  @default(true)
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  scheduleRules             EmployeeScheduleRule[]
  kioskSessions             AttendanceKioskSession[]
  attendanceSessions        EmployeeAttendanceSession[]     @relation("AttendanceBranch")
  plannedAttendanceSessions EmployeeAttendanceSession[]     @relation("AttendancePlannedBranch")
  attendanceDispositions    EmployeeAttendanceDisposition[]
  payrollBatches            EmployeePayrollBatch[]
  attendancePolicyVersions  BranchAttendancePolicyVersion[]
  payrollPolicyVersions     BranchPayrollPolicyVersion[]
  workweekPolicyVersions    BranchWorkweekPolicyVersion[]
  holidayPeriods            BranchHolidayPeriod[]
  employeeSettingsRevision  BranchEmployeeSettingsRevision?
  commissionPlans           CommissionPlan[]

  @@index([isActive, isDefault])
}

model BranchEmployeeSettingsRevision {
  branchId           Int      @id
  attendanceRevision Int      @default(1)
  payrollRevision    Int      @default(1)
  workweekRevision   Int      @default(1)
  holidayRevision    Int      @default(0)
  updatedAt          DateTime @updatedAt

  branch Branch @relation(fields: [branchId], references: [id], onDelete: Restrict)
}

model BranchAttendancePolicyVersion {
  id                         Int                    @id @default(autoincrement())
  branchId                   Int
  effectiveFrom              DateTime               @db.Date
  revision                   Int
  attendanceMode             EmployeeAttendanceMode @default(SHIFT)
  standardDayMinutes         Int                    @default(480)
  lateThresholdMinutes       Int                    @default(0)
  earlyLeaveThresholdMinutes Int                    @default(0)
  allowUnscheduledAttendance Boolean                @default(true)
  createdByUserId            Int?
  createdAt                  DateTime               @default(now())

  branch             Branch                      @relation(fields: [branchId], references: [id], onDelete: Restrict)
  createdBy          User?                       @relation("AttendancePolicyCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)
  attendanceSessions EmployeeAttendanceSession[]

  @@unique([branchId, effectiveFrom], map: "AttendancePolicy_branch_effective_key")
  @@unique([branchId, revision], map: "AttendancePolicy_branch_revision_key")
  @@index([branchId, effectiveFrom])
}

model BranchPayrollPolicyVersion {
  id                      Int                         @id @default(autoincrement())
  branchId                Int
  effectiveFrom           DateTime                    @db.Date
  revision                Int
  frequency               EmployeePayrollFrequency    @default(MONTHLY)
  periodStartDay          Int                         @default(1)
  hourlyCalculationSource EmployeePayrollHourlySource @default(ACTUAL_ATTENDANCE)
  createdByUserId         Int?
  createdAt               DateTime                    @default(now())

  branch    Branch @relation(fields: [branchId], references: [id], onDelete: Restrict)
  createdBy User?  @relation("PayrollPolicyCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@unique([branchId, effectiveFrom], map: "PayrollPolicy_branch_effective_key")
  @@unique([branchId, revision], map: "PayrollPolicy_branch_revision_key")
  @@index([branchId, effectiveFrom])
}

model BranchWorkweekPolicyVersion {
  id              Int      @id @default(autoincrement())
  branchId        Int
  effectiveFrom   DateTime @db.Date
  revision        Int
  monday          Boolean  @default(true)
  tuesday         Boolean  @default(true)
  wednesday       Boolean  @default(true)
  thursday        Boolean  @default(true)
  friday          Boolean  @default(true)
  saturday        Boolean  @default(true)
  sunday          Boolean  @default(true)
  createdByUserId Int?
  createdAt       DateTime @default(now())

  branch    Branch @relation(fields: [branchId], references: [id], onDelete: Restrict)
  createdBy User?  @relation("WorkweekPolicyCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@unique([branchId, effectiveFrom], map: "WorkweekPolicy_branch_effective_key")
  @@unique([branchId, revision], map: "WorkweekPolicy_branch_revision_key")
  @@index([branchId, effectiveFrom])
}

model BranchHolidayPeriod {
  id               Int       @id @default(autoincrement())
  branchId         Int
  name             String    @db.VarChar(160)
  startDate        DateTime  @db.Date
  endDate          DateTime  @db.Date
  note             String?   @db.VarChar(500)
  revision         Int       @default(1)
  archivedAt       DateTime?
  archivedByUserId Int?
  createdByUserId  Int?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  branch     Branch @relation(fields: [branchId], references: [id], onDelete: Restrict)
  createdBy  User?  @relation("HolidayPeriodCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)
  archivedBy User?  @relation("HolidayPeriodArchiver", fields: [archivedByUserId], references: [id], onDelete: SetNull)

  @@index([branchId, startDate, endDate, archivedAt])
}

model Department {
  id        Int      @id @default(autoincrement())
  name      String   @unique @db.VarChar(120)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  employees Employee[]
}

model JobTitle {
  id        Int      @id @default(autoincrement())
  name      String   @unique @db.VarChar(120)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  employees Employee[]
}

model Employee {
  id                Int             @id @default(autoincrement())
  code              String          @unique @db.VarChar(32)
  attendanceCode    String          @unique @db.VarChar(32)
  name              String          @db.VarChar(160)
  phone             String          @db.VarChar(30)
  status            EmployeeStatus  @default(WORKING)
  userId            Int?            @unique
  avatarUrl         String?         @db.VarChar(500)
  departmentId      Int?
  jobTitleId        Int?
  startDate         DateTime?       @db.Date
  endDate           DateTime?       @db.Date
  note              String?         @db.VarChar(500)
  nationalId        String?         @unique @db.VarChar(32)
  birthDate         DateTime?       @db.Date
  gender            EmployeeGender?
  address           String?         @db.VarChar(255)
  province          String?         @db.VarChar(120)
  ward              String?         @db.VarChar(120)
  email             String?         @db.VarChar(160)
  facebook          String?         @db.VarChar(255)
  bankName          String?         @db.VarChar(120)
  bankAccountNumber String?         @db.VarChar(80)
  bankAccountName   String?         @db.VarChar(120)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  user                      User?                           @relation(fields: [userId], references: [id], onDelete: SetNull)
  department                Department?                     @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  jobTitle                  JobTitle?                       @relation(fields: [jobTitleId], references: [id], onDelete: Restrict)
  compensations             EmployeeCompensation[]
  scheduleRules             EmployeeScheduleRule[]
  attendanceSessions        EmployeeAttendanceSession[]
  attendanceDispositions    EmployeeAttendanceDisposition[]
  payrollLines              EmployeePayrollLine[]
  payrollPayments           EmployeePayrollPayment[]
  commissionPlanAssignments CommissionPlanEmployee[]
  commissionOrderItems      OrderItem[]                     @relation("OrderItemCommissionEmployee")
  commissionSaleBases       CommissionSaleBasis[]           @relation("CommissionSaleBasisEmployee")
  commissionEntries         CommissionEntry[]

  receivedOrders Order[] @relation("OrderReceiver")

  @@index([status, createdAt])
  @@index([name])
  @@index([departmentId, status])
  @@index([jobTitleId, status])
}

model EmployeeCompensation {
  id              Int              @id @default(autoincrement())
  employeeId      Int
  payBasis        EmployeePayBasis
  baseRate        Int
  effectiveFrom   DateTime         @db.Date
  note            String?          @db.VarChar(500)
  createdByUserId Int?
  createdAt       DateTime         @default(now())

  employee  Employee @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  createdBy User?    @relation("EmployeeCompensationCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@unique([employeeId, effectiveFrom])
  @@index([employeeId, effectiveFrom])
}

model EmployeePayrollBatch {
  id                                 Int                @id @default(autoincrement())
  code                               String             @unique @db.VarChar(32)
  name                               String             @db.VarChar(160)
  branchId                           Int                @default(1)
  frequency                          PayrollFrequency   @default(MONTHLY)
  periodStart                        DateTime           @db.Date
  periodEnd                          DateTime           @db.Date
  status                             PayrollBatchStatus @default(DRAFT)
  totalGrossAmount                   Int                @default(0)
  totalAdjustmentAmount              Int                @default(0)
  totalNetAmount                     Int                @default(0)
  totalPaidAmount                    Int                @default(0)
  totalRemainingAmount               Int                @default(0)
  totalCommissionAmount              Int                @default(0)
  totalCommissionDeferredDebitAmount Int                @default(0)
  createdByUserId                    Int
  calculatedByUserId                 Int?
  calculatedAt                       DateTime?
  finalizedByUserId                  Int?
  finalizedAt                        DateTime?
  cancelledByUserId                  Int?
  cancelledAt                        DateTime?
  cancelReason                       String?            @db.VarChar(500)
  version                            Int                @default(1)
  createdAt                          DateTime           @default(now())
  updatedAt                          DateTime           @updatedAt

  branch                Branch                        @relation(fields: [branchId], references: [id], onDelete: Restrict)
  createdBy             User                          @relation("EmployeePayrollBatchCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  calculatedBy          User?                         @relation("EmployeePayrollBatchCalculator", fields: [calculatedByUserId], references: [id], onDelete: Restrict)
  finalizedBy           User?                         @relation("EmployeePayrollBatchFinalizer", fields: [finalizedByUserId], references: [id], onDelete: Restrict)
  cancelledBy           User?                         @relation("EmployeePayrollBatchCanceller", fields: [cancelledByUserId], references: [id], onDelete: Restrict)
  lines                 EmployeePayrollLine[]
  payments              EmployeePayrollPayment[]
  idempotencies         EmployeePayrollIdempotency[]
  commissionAllocations CommissionPayrollAllocation[]

  @@index([branchId, periodStart, periodEnd, status])
  @@index([status, createdAt])
}

model EmployeePayrollLine {
  id                            Int                      @id @default(autoincrement())
  payrollBatchId                Int
  employeeId                    Int
  employeeCode                  String                   @db.VarChar(32)
  employeeName                  String                   @db.VarChar(160)
  departmentName                String?                  @db.VarChar(120)
  jobTitleName                  String?                  @db.VarChar(120)
  bankName                      String?                  @db.VarChar(120)
  bankAccountNumber             String?                  @db.VarChar(80)
  bankAccountName               String?                  @db.VarChar(120)
  employmentStartDate           DateTime?                @db.Date
  employmentEndDate             DateTime?                @db.Date
  activeCalendarDays            Int                      @default(0)
  periodCalendarDays            Int                      @default(0)
  scheduledShifts               Int                      @default(0)
  completedSessions             Int                      @default(0)
  actualMinutes                 Int                      @default(0)
  confirmedAbsences             Int                      @default(0)
  missingCheckouts              Int                      @default(0)
  reviewRequiredCount           Int                      @default(0)
  grossAmount                   Int                      @default(0)
  bonusAmount                   Int                      @default(0)
  deductionAmount               Int                      @default(0)
  commissionAmount              Int                      @default(0)
  commissionDeferredDebitAmount Int                      @default(0)
  netAmount                     Int                      @default(0)
  paidAmount                    Int                      @default(0)
  remainingAmount               Int                      @default(0)
  calculationStatus             PayrollCalculationStatus @default(READY)
  warningCodes                  Json
  sourceSnapshot                Json
  calculatedAt                  DateTime
  createdAt                     DateTime                 @default(now())
  updatedAt                     DateTime                 @updatedAt

  payrollBatch          EmployeePayrollBatch          @relation(fields: [payrollBatchId], references: [id], onDelete: Restrict)
  employee              Employee                      @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  adjustments           EmployeePayrollAdjustment[]
  payments              EmployeePayrollPayment[]
  commissionAllocations CommissionPayrollAllocation[]

  @@unique([payrollBatchId, employeeId], map: "EmployeePayrollLine_batch_employee_key")
  @@index([employeeId, calculatedAt])
  @@index([payrollBatchId, calculationStatus])
}

model EmployeePayrollAdjustment {
  id               Int                   @id @default(autoincrement())
  payrollLineId    Int
  type             PayrollAdjustmentType
  amount           Int
  reason           String                @db.VarChar(500)
  createdByUserId  Int
  createdAt        DateTime              @default(now())
  reversedAt       DateTime?
  reversedByUserId Int?
  reverseReason    String?               @db.VarChar(500)

  payrollLine EmployeePayrollLine @relation(fields: [payrollLineId], references: [id], onDelete: Restrict)
  createdBy   User                @relation("EmployeePayrollAdjustmentCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  reversedBy  User?               @relation("EmployeePayrollAdjustmentReverser", fields: [reversedByUserId], references: [id], onDelete: Restrict)

  @@index([payrollLineId, reversedAt, createdAt])
}

model EmployeePayrollPayment {
  id                 Int                  @id @default(autoincrement())
  payrollBatchId     Int
  payrollLineId      Int
  employeeId         Int
  amount             Int
  method             PayrollPaymentMethod
  financialAccountId Int?
  externalReference  String?              @db.VarChar(120)
  note               String?              @db.VarChar(500)
  status             PayrollPaymentStatus @default(SUCCESS)
  paidAt             DateTime
  createdByUserId    Int
  createdAt          DateTime             @default(now())
  reversedAt         DateTime?
  reversedByUserId   Int?
  reverseReason      String?              @db.VarChar(500)

  payrollBatch     EmployeePayrollBatch @relation(fields: [payrollBatchId], references: [id], onDelete: Restrict)
  payrollLine      EmployeePayrollLine  @relation(fields: [payrollLineId], references: [id], onDelete: Restrict)
  employee         Employee             @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  createdBy        User                 @relation("EmployeePayrollPaymentCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  reversedBy       User?                @relation("EmployeePayrollPaymentReverser", fields: [reversedByUserId], references: [id], onDelete: Restrict)
  financialAccount FinancialAccount?    @relation(fields: [financialAccountId], references: [id], onDelete: Restrict)

  @@index([payrollLineId, status, paidAt])
  @@index([payrollBatchId, status, paidAt])
  @@index([employeeId, paidAt])
  @@index([financialAccountId, paidAt])
}

model EmployeePayrollIdempotency {
  id             Int      @id @default(autoincrement())
  actorId        Int
  operation      String   @db.VarChar(80)
  idempotencyKey String   @db.VarChar(128)
  requestDigest  String   @db.Char(64)
  response       Json
  payrollBatchId Int?
  createdAt      DateTime @default(now())

  actor        User                  @relation(fields: [actorId], references: [id], onDelete: Restrict)
  payrollBatch EmployeePayrollBatch? @relation(fields: [payrollBatchId], references: [id], onDelete: Restrict)

  @@unique([actorId, operation, idempotencyKey], map: "EmployeePayrollIdempotency_actor_operation_key")
  @@index([payrollBatchId])
}

model EmployeeScheduleIdempotency {
  id             Int      @id @default(autoincrement())
  actorId        Int
  operation      String   @db.VarChar(80)
  idempotencyKey String   @db.VarChar(128)
  requestDigest  String   @db.Char(64)
  response       Json
  createdAt      DateTime @default(now())

  actor User @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@unique([actorId, operation, idempotencyKey], map: "EmployeeScheduleIdempotency_actor_operation_key")
}

model WorkShift {
  id              Int      @id @default(autoincrement())
  code            String   @unique @db.VarChar(40)
  name            String   @unique @db.VarChar(120)
  startMinute     Int
  endMinute       Int
  isActive        Boolean  @default(true)
  createdByUserId Int?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  createdBy User?                  @relation("WorkShiftCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)
  rules     EmployeeScheduleRule[]

  @@index([isActive, name])
}

model EmployeeScheduleRule {
  id                      Int                    @id @default(autoincrement())
  employeeId              Int
  branchId                Int                    @default(1)
  shiftId                 Int
  recurrenceType          ScheduleRecurrenceType
  startDate               DateTime               @db.Date
  endDate                 DateTime?              @db.Date
  dayOfWeek               Int?
  cancelledAt             DateTime?
  cancelledByUserId       Int?
  createdByUserId         Int
  createdAt               DateTime               @default(now())
  updatedAt               DateTime               @updatedAt
  calendarWarningSnapshot Json?

  employee               Employee                        @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  branch                 Branch                          @relation(fields: [branchId], references: [id], onDelete: Restrict)
  shift                  WorkShift                       @relation(fields: [shiftId], references: [id], onDelete: Restrict)
  createdBy              User                            @relation("EmployeeScheduleRuleCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  cancelledBy            User?                           @relation("EmployeeScheduleRuleCanceller", fields: [cancelledByUserId], references: [id], onDelete: SetNull)
  exceptions             EmployeeScheduleException[]
  attendanceSessions     EmployeeAttendanceSession[]
  attendanceDispositions EmployeeAttendanceDisposition[]

  @@unique([branchId, employeeId, shiftId, recurrenceType, startDate, dayOfWeek], map: "EmployeeScheduleRule_duplicate_key")
  @@index([employeeId, startDate, endDate])
  @@index([branchId, employeeId, startDate])
