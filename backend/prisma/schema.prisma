model CashVoucher {
  id                      Int                   @id @default(autoincrement())
  code                    String                @unique @db.VarChar(40)
  direction               CashVoucherDirection
  status                  CashVoucherStatus     @default(POSTED)
  occurredAt              DateTime              @db.DateTime(3)
  amount                  Int
  accountId               Int
  categoryId              Int
  paymentMethod           PaymentMethod?
  handlerUserId           Int?
  handlerName             String?               @db.VarChar(120)
  counterpartyType        String?               @db.VarChar(50)
  counterpartyId          Int?
  counterpartyName        String?               @db.VarChar(160)
  note                    String?               @db.VarChar(1000)
  affectsBusinessResult   Boolean               @default(false)
  sourceType              CashVoucherSourceType
  sourceTransactionId     Int?
  sourceCode              String?               @db.VarChar(100)
  sourceKey               String                @unique @db.VarChar(191)
  clientRequestId         String?               @db.VarChar(128)
  linkedPurchaseReceiptId Int?
  sourceInvoiceNumber     String?               @db.VarChar(100)
  sourceInvoiceDate       DateTime?             @db.DateTime(3)
  reversalOfId            Int?                  @unique
  cancelledAt             DateTime?             @db.DateTime(3)
  cancelledByUserId       Int?
  cancelReason            String?               @db.VarChar(500)
  createdByUserId         Int
  createdAt               DateTime              @default(now()) @db.DateTime(3)
  updatedAt               DateTime              @updatedAt @db.DateTime(3)

  account               FinancialAccount @relation(fields: [accountId], references: [id], onDelete: Restrict)
  category              CashFlowCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  handler               User?            @relation("CashVoucherHandler", fields: [handlerUserId], references: [id], onDelete: SetNull)
  cancelledBy           User?            @relation("CashVoucherCanceller", fields: [cancelledByUserId], references: [id], onDelete: SetNull)
  createdBy             User             @relation("CashVoucherCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  linkedPurchaseReceipt PurchaseReceipt? @relation(fields: [linkedPurchaseReceiptId], references: [id], onDelete: SetNull)
  reversalOf            CashVoucher?     @relation("CashVoucherReversal", fields: [reversalOfId], references: [id], onDelete: Restrict)
  reversal              CashVoucher?     @relation("CashVoucherReversal")

  @@unique([createdByUserId, clientRequestId])
  @@index([accountId, occurredAt, id])
  @@index([categoryId, occurredAt])
  @@index([sourceType, sourceTransactionId])
  @@index([createdByUserId, createdAt])
  @@index([linkedPurchaseReceiptId])
