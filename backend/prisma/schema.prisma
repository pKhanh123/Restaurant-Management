// Append-only audit snapshots. Corrections must create a separate history event.
model OrderItemCancellation {
  id                       Int                          @id @default(autoincrement())
  orderId                  Int
  orderItemId              Int
  menuItemId               Int
  menuItemSku              String
  menuItemName             String
  quantity                 Int
  unitPrice                Int
  lineAmount               Int
  reason                   String                       @db.VarChar(1000)
  cancelledAt              DateTime
  cancelledByUserId        Int?
  orderStatusSnapshot      OrderStatus
  preparationStateSnapshot CancellationPreparationState
  inventoryEffect          CancellationInventoryEffect
  // VOID_RESTORE is reconciled via orderId; waste has an explicit source FK.
  inventoryWasteId         Int?
  source                   OrderItemCancellationSource
  // ORDER_VOID:<orderId>:<orderItemId>; writers must preserve this exact key.
  sourceKey                String                       @unique @db.VarChar(191)
  createdAt                DateTime                     @default(now())

  order           Order           @relation(fields: [orderId], references: [id], onDelete: Restrict)
  orderItem       OrderItem       @relation(fields: [orderItemId], references: [id], onDelete: Restrict)
  menuItem        MenuItem        @relation(fields: [menuItemId], references: [id], onDelete: Restrict)
  cancelledByUser User?           @relation("OrderItemCancellationActor", fields: [cancelledByUserId], references: [id], onDelete: Restrict)
  inventoryWaste  InventoryWaste? @relation(fields: [inventoryWasteId], references: [id], onDelete: Restrict)

  @@index([cancelledAt, orderId])
  @@index([cancelledByUserId, cancelledAt])
  @@index([source, orderId])
  @@index([orderId])
  @@index([orderItemId])
  @@index([menuItemId])
  @@index([inventoryWasteId])
}

