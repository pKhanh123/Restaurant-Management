model Order {
  id                 Int            @id @default(autoincrement())
  code               String         @unique // Ma don CRISPY-YYYYMMDD-XXXX
  orderType          OrderType      @default(DINE_IN)
  status             OrderStatus    @default(PENDING)
  tableId            Int?
  customerId         Int?
  reservationId      Int?
  deliveryPartnerId  Int?
  deliveryAddress    String?        @db.VarChar(255)
  deliveryFee        Int            @default(0)
  deliveryFeePaid    Int            @default(0)
  priceListId        Int?
  buzzerNumber       Int?
  totalAmount        Int // Tong tien truoc thue (VND)
  discountAmount     Int            @default(0) // Tien giam gia tu voucher (VND)
  vatAmount          Int // Tien thue VAT 8% (VND)
  finalAmount        Int // Tong thanh toan (VND)
  voucherId          Int?
  voucherCode        String?
  paymentMethod      PaymentMethod?
  paymentStatus      PaymentStatus  @default(UNPAID)
  payLaterAuthorized Boolean        @default(false)
  paidAt             DateTime?
  notes              String?

  // Audit fields
  createdByUserId      Int?
  receivedByEmployeeId Int?
  voidedByUserId       Int?
  voidReason           String?
  voidedAt             DateTime?

  // Lifecycle Timestamps
  preparingAt DateTime?
  readyAt     DateTime?
  completedAt DateTime?
  cancelledAt DateTime?

  // Idempotency & Fingerprint
  idempotencyKey   String?
  idempotencyScope String  @default("guest")
  requestHash      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  table                 DiningTable?              @relation(fields: [tableId], references: [id], onDelete: SetNull)
  customer              Customer?                 @relation(fields: [customerId], references: [id], onDelete: SetNull)
  reservation           Reservation?              @relation(fields: [reservationId], references: [id], onDelete: SetNull)
  deliveryPartner       DeliveryPartner?          @relation(fields: [deliveryPartnerId], references: [id], onDelete: Restrict)
  priceList             PriceList?                @relation(fields: [priceListId], references: [id], onDelete: SetNull)
  createdByUser         User?                     @relation("CreatedOrders", fields: [createdByUserId], references: [id], onDelete: SetNull)
  receivedByEmployee    Employee?                 @relation("OrderReceiver", fields: [receivedByEmployeeId], references: [id], onDelete: Restrict)
  voidedByUser          User?                     @relation("VoidedOrders", fields: [voidedByUserId], references: [id], onDelete: SetNull)
  voucher               Voucher?                  @relation(fields: [voucherId], references: [id], onDelete: SetNull)
  items                 OrderItem[]
  inventoryTransactions InventoryTransaction[]
  returns               OrderReturn[]
  paymentTransactions   OrderPaymentTransaction[]
  commissionSaleBases   CommissionSaleBasis[]
  commissionEntries     CommissionEntry[]
  itemCancellations     OrderItemCancellation[]

  @@unique([idempotencyScope, idempotencyKey])
  @@index([voucherId])
  @@index([deliveryPartnerId, status])
  @@index([customerId, createdAt])
  @@index([reservationId])
  @@index([status, completedAt])
  @@index([receivedByEmployeeId, completedAt])
}

