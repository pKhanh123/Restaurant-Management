  createdAt  DateTime @default(now())

  actor User? @relation("AuditLogs", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([actorId])
  @@index([action])
  @@index([targetType, targetId])
  @@index([createdAt])
}

enum InventoryTransactionType {
  STOCK_IN
  PURCHASE_RETURN
  AUTO_DEDUCT
  KITCHEN_WASTE
  MANUAL_ADJUST
  VOID_RESTORE
  SALES_RETURN
}

enum InventoryCheckStatus {
  DRAFT
  BALANCED
  CANCELLED
}

enum InventoryWasteStatus {
  DRAFT
  COMPLETED
  CANCELLED
}

model Ingredient {
  id           Int      @id @default(autoincrement())
  sku          String   @unique // Ma nguyen lieu (VD: ING-CHICKEN-01)
  name         String // Ten nguyen lieu
  unit         String // Don vi: gram, ml, piece, can...
