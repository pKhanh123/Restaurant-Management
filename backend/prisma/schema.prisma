// backend/prisma/schema.prisma
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  CASHIER
  KITCHEN
  ADMIN
}

enum OrderType {
  DINE_IN
  TAKE_AWAY
}

enum OrderStatus {
  PENDING
  PREPARING
  READY
  COMPLETED
  CANCELLED
}

enum TableStatus {
  AVAILABLE
  OCCUPIED
  DIRTY
  NEED_CLEANING
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  CREDIT_CARD
  E_WALLET
}

enum PaymentStatus {
  UNPAID
  PAID
  VOIDED
}

enum FinancialAccountType {
  CASH
  BANK
  E_WALLET
}

enum CashVoucherDirection {
  RECEIPT
  PAYMENT
}

enum CashVoucherStatus {
  POSTED
  CANCELLED
}

enum CashVoucherSourceType {
  MANUAL
  ORDER_PAYMENT
  SALES_RETURN
  PURCHASE_RECEIPT
  PURCHASE_RETURN
  REVERSAL
}

model FinancialAccount {
  id               Int                  @id @default(autoincrement())
  code             String               @unique @db.VarChar(50)
  name             String               @db.VarChar(150)
  type             FinancialAccountType
  openingBalance   Int                  @default(0)
  openingAt        DateTime?
  bankName         String?              @db.VarChar(150)
  accountNumber    String?              @db.VarChar(100)
  walletProvider   String?              @db.VarChar(150)
  walletIdentifier String?              @db.VarChar(100)
  isDefault        Boolean              @default(false)
  isActive         Boolean              @default(true)
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  vouchers         CashVoucher[]
  purchaseReceipts PurchaseReceipt[] @relation("PurchaseReceiptFinancialAccount")
  purchaseReturns  PurchaseReturn[]  @relation("PurchaseReturnFinancialAccount")

  @@index([type, isActive])
}

model CashFlowCategory {
  id                           Int                  @id @default(autoincrement())
  code                         String               @unique @db.VarChar(60)
  name                         String               @db.VarChar(150)
  direction                    CashVoucherDirection
  affectsBusinessResultDefault Boolean              @default(true)
  isSystem                     Boolean              @default(false)
  isActive                     Boolean              @default(true)
  createdAt                    DateTime             @default(now())
  updatedAt                    DateTime             @updatedAt

  vouchers CashVoucher[]

  @@index([direction, isActive])
}

model FinancialParty {
  id        Int      @id @default(autoincrement())
  name      String   @db.VarChar(150)
  phone     String?  @db.VarChar(30)
  note      String?  @db.VarChar(1000)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([name])
  @@index([isActive])
}

model CashbookSetting {
  id                Int       @id @default(1)
  activatedAt       DateTime?
  activatedByUserId Int?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
}

model CashVoucher {
  id                      Int                   @id @default(autoincrement())
  code                    String                @unique @db.VarChar(50)
  direction               CashVoucherDirection
  status                  CashVoucherStatus     @default(POSTED)
  occurredAt              DateTime
  amount                  Int
  accountId               Int
  categoryId              Int
  paymentMethod           PaymentMethod?
  handlerUserId           Int?
  handlerName             String?               @db.VarChar(120)
  counterpartyType        String?               @db.VarChar(50)
  counterpartyId          Int?
  counterpartyName        String?               @db.VarChar(200)
  note                    String?               @db.VarChar(1000)
  affectsBusinessResult   Boolean               @default(true)
  sourceType              CashVoucherSourceType
  sourceId                Int?
  sourceCode              String?               @db.VarChar(100)
  sourceKey               String                @unique @db.VarChar(191)
  linkedPurchaseReceiptId Int?
  sourceInvoiceNumber     String?               @db.VarChar(100)
  sourceInvoiceDate       DateTime?
  reversalOfId            Int?                  @unique
  cancelledAt             DateTime?
  cancelledByUserId       Int?
  cancelReason            String?               @db.VarChar(500)
  createdByUserId         Int?
  createdAt               DateTime              @default(now())
  updatedAt               DateTime              @updatedAt

  account               FinancialAccount @relation(fields: [accountId], references: [id], onDelete: Restrict)
  category              CashFlowCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  linkedPurchaseReceipt PurchaseReceipt? @relation(fields: [linkedPurchaseReceiptId], references: [id], onDelete: Restrict)
  reversalOf            CashVoucher?     @relation("CashVoucherReversal", fields: [reversalOfId], references: [id], onDelete: Restrict)
  reversal              CashVoucher?     @relation("CashVoucherReversal")

  @@index([accountId, occurredAt])
  @@index([direction, status, occurredAt])
  @@index([categoryId])
  @@index([linkedPurchaseReceiptId])
}

enum MenuType {
  FOOD
  DRINK
  SERVICE
  OTHER
}

enum MenuItemType {
  REGULAR
  TOPPING
  COMBO
  SERVICE
}

enum OrderReturnStatus {
  COMPLETED
  CANCELLED
}

enum PriceListType {
  GENERAL
  CUSTOM
}

enum PriceListScopeType {
  GLOBAL
  BRANCH
  CHANNEL
  CUSTOMER_GROUP
}

model User {
  id           Int      @id @default(autoincrement())
  username     String   @unique
  passwordHash String
  name         String
  role         Role     @default(CASHIER)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  createdOrders Order[]    @relation("CreatedOrders")
  voidedOrders  Order[]    @relation("VoidedOrders")
  auditLogs     AuditLog[] @relation("AuditLogs")
}

model Category {
  id           Int        @id @default(autoincrement())
  name         String
  displayOrder Int        @default(0)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  menuItems    MenuItem[]
}

model PriceList {
  id              Int                @id @default(autoincrement())
  code            String             @unique
  name            String
  type            PriceListType      @default(GENERAL)
  scopeType       PriceListScopeType @default(GLOBAL)
  scopeKey        String?
  isDefault       Boolean            @default(false)
  isActive        Boolean            @default(true)
  effectiveFrom   DateTime?
  effectiveTo     DateTime?
  createdByUserId Int?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  items  PriceListItem[]
  orders Order[]

  @@index([scopeType, scopeKey])
  @@index([isDefault, isActive])
  @@index([effectiveFrom, effectiveTo])
}

model MenuItem {
  id            Int          @id @default(autoincrement())
  categoryId    Int
  sku           String       @unique
  name          String
  description   String?      @db.Text
  basePrice     Int // VND nguyen
  imageUrl      String?
  isAvailable   Boolean      @default(true)
  displayOrder  Int          @default(0)
  menuType      MenuType     @default(FOOD)
  itemType      MenuItemType @default(REGULAR)
  trackStock    Boolean      @default(false)
  stockQuantity Int          @default(0)
  position      String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  category            Category             @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  modifierGroups      ModifierGroup[]
  orderItems          OrderItem[]
  priceListItems      PriceListItem[]
  menuItemIngredients MenuItemIngredient[]
}

model PriceListItem {
  id          Int      @id @default(autoincrement())
  priceListId Int
  menuItemId  Int
  salePrice   Int
  version     Int      @default(1)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  priceList PriceList @relation(fields: [priceListId], references: [id], onDelete: Cascade)
  menuItem  MenuItem  @relation(fields: [menuItemId], references: [id], onDelete: Restrict)

  @@unique([priceListId, menuItemId])
  @@index([menuItemId])
}

model ModifierGroup {
  id         Int      @id @default(autoincrement())
  menuItemId Int
  name       String
  isRequired Boolean  @default(false)
  minSelect  Int      @default(0)
  maxSelect  Int      @default(1)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  menuItem MenuItem         @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  options  ModifierOption[]
}

model ModifierOption {
  id              Int      @id @default(autoincrement())
  modifierGroupId Int
  name            String
  priceDelta      Int      @default(0) // VND phu phi
  isAvailable     Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  modifierGroup ModifierGroup @relation(fields: [modifierGroupId], references: [id], onDelete: Cascade)
}

model DiningTable {
  id             Int         @id @default(autoincrement())
  tableNumber    Int         @unique
  displayName    String?     @db.VarChar(100)
  areaId         Int?
  qrCodeToken    String      @unique
  status         TableStatus @default(AVAILABLE)
  capacity       Int         @default(4)
  displayOrder   Int         @default(0)
  note           String?     @db.VarChar(500)
  isActive       Boolean     @default(true)
  currentOrderId Int?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  orders Order[]
  area   TableArea? @relation(fields: [areaId], references: [id], onDelete: Restrict)

  @@index([areaId])
  @@index([isActive])
}

model TableArea {
  id           Int           @id @default(autoincrement())
  name         String        @unique @db.VarChar(100)
  displayOrder Int           @default(0)
  isActive     Boolean       @default(true)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  tables       DiningTable[]

  @@index([isActive, displayOrder])
}

model Order {
  id            Int            @id @default(autoincrement())
  code          String         @unique // Ma don CRISPY-YYYYMMDD-XXXX
  orderType     OrderType      @default(DINE_IN)
  status        OrderStatus    @default(PENDING)
  tableId       Int?
  priceListId   Int?
  buzzerNumber  Int?
  totalAmount   Int // Tong tien truoc thue (VND)
  vatAmount     Int // Tien thue VAT 8% (VND)
  finalAmount   Int // Tong thanh toan (VND)
  paymentMethod PaymentMethod?
  paymentStatus PaymentStatus  @default(UNPAID)
  paidAt        DateTime?
  notes         String?

  // Audit fields
  createdByUserId Int?
  voidedByUserId  Int?
  voidReason      String?
  voidedAt        DateTime?

  // Lifecycle Timestamps
  preparingAt DateTime?
  readyAt     DateTime?
  completedAt DateTime?
  cancelledAt DateTime?

  // Idempotency & Fingerprint
  idempotencyKey   String?
  idempotencyScope String  @default("guest")
  requestHash      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  table                 DiningTable?           @relation(fields: [tableId], references: [id], onDelete: SetNull)
  priceList             PriceList?             @relation(fields: [priceListId], references: [id], onDelete: SetNull)
  createdByUser         User?                  @relation("CreatedOrders", fields: [createdByUserId], references: [id], onDelete: SetNull)
  voidedByUser          User?                  @relation("VoidedOrders", fields: [voidedByUserId], references: [id], onDelete: SetNull)
  items                 OrderItem[]
  inventoryTransactions InventoryTransaction[]
  returns               OrderReturn[]

  @@unique([idempotencyScope, idempotencyKey])
}

model OrderItem {
  id                    Int      @id @default(autoincrement())
  orderId               Int
  menuItemId            Int
  quantity              Int      @default(1)
  unitPrice             Int // Don gia tai thoi diem dat (VND)
  subtotal              Int // quantity * (unitPrice + modifiers)
  selectedModifiersJson Json? // Snapshot cac options da chon
  notes                 String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  order       Order             @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItem    MenuItem          @relation(fields: [menuItemId], references: [id], onDelete: Restrict)
  returnLines OrderReturnLine[]
}

model OrderReturn {
  id                Int               @id @default(autoincrement())
  returnCode        String            @unique
  orderId           Int
  status            OrderReturnStatus @default(COMPLETED)
  returnedAt        DateTime          @default(now())
  totalRefundDue    Int               @default(0)
  refundedAmount    Int               @default(0)
  refundMethod      PaymentMethod     @default(CASH)
  note              String?           @db.VarChar(1000)
  createdByUserId   Int?
  createdByName     String?           @db.VarChar(120)
  completedAt       DateTime?
  cancelledByUserId Int?
  cancelledAt       DateTime?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  order                 Order                  @relation(fields: [orderId], references: [id], onDelete: Restrict)
  lines                 OrderReturnLine[]
  inventoryTransactions InventoryTransaction[]

  @@index([status, returnedAt])
  @@index([orderId, returnedAt])
}

model OrderReturnLine {
  id            Int      @id @default(autoincrement())
  orderReturnId Int
  orderItemId   Int
  menuItemId    Int
  menuItemSku   String
  menuItemName  String
  quantity      Int
  unitPrice     Int
  lineAmount    Int
  createdAt     DateTime @default(now())

  orderReturn OrderReturn @relation(fields: [orderReturnId], references: [id], onDelete: Cascade)
  orderItem   OrderItem   @relation(fields: [orderItemId], references: [id], onDelete: Restrict)

  @@unique([orderReturnId, orderItemId])
  @@index([orderItemId])
  @@index([menuItemId])
}

model AuditLog {
  id         Int      @id @default(autoincrement())
  action     String // MENU_ITEM_CREATED | MENU_ITEM_UPDATED | MENU_ITEM_AVAILABILITY_CHANGED | MENU_IMAGE_UPLOADED | ORDER_VOIDED
  targetType String // MenuItem | Order
  targetId   Int?
  actorId    Int?
  actorName  String? // Snapshot ten user tai thoi diem log
  metadata   Json? // Chi tiet thay doi (ten cu, ten moi, gia cu, gia moi...)
  createdAt  DateTime @default(now())

  actor User? @relation("AuditLogs", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([actorId])
  @@index([action])
  @@index([targetType, targetId])
  @@index([createdAt])
}

enum InventoryTransactionType {
  STOCK_IN
  PURCHASE_RETURN
  AUTO_DEDUCT
  KITCHEN_WASTE
  MANUAL_ADJUST
  VOID_RESTORE
  SALES_RETURN
}

enum InventoryCheckStatus {
  DRAFT
  BALANCED
  CANCELLED
}

enum InventoryWasteStatus {
  DRAFT
  COMPLETED
  CANCELLED
}

model Ingredient {
  id           Int      @id @default(autoincrement())
  sku          String   @unique // Ma nguyen lieu (VD: ING-CHICKEN-01)
  name         String // Ten nguyen lieu
  unit         String // Don vi: gram, ml, piece, can...
  currentStock Float    @default(0) // Ton kho thuc te
  minThreshold Float    @default(0) // Nguong canh bao do
  costPerUnit  Int      @default(0) // Gia von trung binh (VND / don vi tinh)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  menuItemIngredients   MenuItemIngredient[]
  inventoryTransactions InventoryTransaction[]
  inventoryCheckLines   InventoryCheckLine[]
  inventoryWasteLines   InventoryWasteLine[]
  purchaseReceiptLines  PurchaseReceiptLine[]
  purchaseReturnLines   PurchaseReturnLine[]

  @@index([sku])
  @@index([isActive])
}

model MenuItemIngredient {
  id               Int   @id @default(autoincrement())
  menuItemId       Int
  ingredientId     Int
  quantityRequired Float // Dinh luong tieu hao cho 1 phan mon an

  menuItem   MenuItem   @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  ingredient Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Restrict)

  @@unique([menuItemId, ingredientId])
  @@index([menuItemId])
  @@index([ingredientId])
}

model InventoryTransaction {
  id                Int                      @id @default(autoincrement())
  ingredientId      Int
  type              InventoryTransactionType
  quantity          Float // + khi nhap kho, - khi xuat/hao hut
  costAmount        Int                      @default(0) // Gia tri VND giao dich
  orderId           Int? // Don hang lien quan (khi auto-deduct)
  purchaseReceiptId Int? // Chung tu nhap; null cho ledger cu
  inventoryCheckId  Int? // Chung tu kiem kho; null cho ledger khac
  inventoryWasteId  Int? // Chung tu xuat huy; null cho ledger khac
  purchaseReturnId  Int?
  orderReturnId     Int?
  note              String? // Ghi chu
  createdByUserId   Int?
  createdAt         DateTime                 @default(now())

  ingredient      Ingredient       @relation(fields: [ingredientId], references: [id], onDelete: Restrict)
  order           Order?           @relation(fields: [orderId], references: [id], onDelete: SetNull)
  purchaseReceipt PurchaseReceipt? @relation(fields: [purchaseReceiptId], references: [id], onDelete: Restrict)
  inventoryCheck  InventoryCheck?  @relation(fields: [inventoryCheckId], references: [id], onDelete: Restrict)
  inventoryWaste  InventoryWaste?  @relation(fields: [inventoryWasteId], references: [id], onDelete: Restrict)
  purchaseReturn  PurchaseReturn?  @relation(fields: [purchaseReturnId], references: [id], onDelete: Restrict)
  orderReturn     OrderReturn?     @relation(fields: [orderReturnId], references: [id], onDelete: Restrict)

  @@unique([purchaseReturnId, ingredientId])
  @@unique([orderReturnId, ingredientId])
  @@index([ingredientId])
  @@index([type])
  @@index([createdAt])
  @@index([purchaseReceiptId])
  @@index([inventoryCheckId])
  @@index([inventoryWasteId])
  @@index([orderReturnId])
}

model InventoryCheck {
  id                Int                  @id @default(autoincrement())
  checkCode         String               @unique
  status            InventoryCheckStatus @default(DRAFT)
  countedAt         DateTime             @default(now())
  balancedAt        DateTime?
  note              String?              @db.VarChar(1000)
  createdByUserId   Int?
  balancedByUserId  Int?
  cancelledByUserId Int?
  cancelledAt       DateTime?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  lines                 InventoryCheckLine[]
  inventoryTransactions InventoryTransaction[]

  @@index([status, countedAt])
  @@index([countedAt])
}

model InventoryCheckLine {
  id               Int      @id @default(autoincrement())
  inventoryCheckId Int
  ingredientId     Int
  ingredientSku    String
  ingredientName   String
  unit             String
  systemQuantity   Float
  actualQuantity   Float?
  varianceQuantity Float?
  costPerUnit      Int
  varianceValue    Int?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  inventoryCheck InventoryCheck @relation(fields: [inventoryCheckId], references: [id], onDelete: Cascade)
  ingredient     Ingredient     @relation(fields: [ingredientId], references: [id], onDelete: Restrict)

  @@unique([inventoryCheckId, ingredientId])
  @@index([ingredientId])
}

model InventoryWaste {
  id                Int                  @id @default(autoincrement())
  wasteCode         String               @unique
  status            InventoryWasteStatus @default(DRAFT)
  wastedAt          DateTime             @default(now())
  completedAt       DateTime?
  note              String?              @db.VarChar(1000)
  totalValue        Int                  @default(0)
  createdByUserId   Int?
  completedByUserId Int?
  cancelledByUserId Int?
  cancelledAt       DateTime?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  lines                 InventoryWasteLine[]
  inventoryTransactions InventoryTransaction[]

  @@index([status, wastedAt])
  @@index([wastedAt])
}

model InventoryWasteLine {
  id               Int      @id @default(autoincrement())
  inventoryWasteId Int
  ingredientId     Int
  ingredientSku    String
  ingredientName   String
  unit             String
  systemQuantity   Float
  quantity         Float
  costPerUnit      Int
  lineValue        Int
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  inventoryWaste InventoryWaste @relation(fields: [inventoryWasteId], references: [id], onDelete: Cascade)
  ingredient     Ingredient     @relation(fields: [ingredientId], references: [id], onDelete: Restrict)

  @@unique([inventoryWasteId, ingredientId])
  @@index([ingredientId])
}

enum PurchaseReceiptStatus {
  DRAFT
  POSTED
  CANCELLED
}

model Supplier {
  id             Int      @id @default(autoincrement())
  code           String   @unique
  name           String
  phone          String?
  email          String?
  address        String?  @db.VarChar(255)
  taxCode        String?
  note           String?  @db.VarChar(1000)
  identityNumber String?  @db.VarChar(20)
  province       String?  @db.VarChar(100)
  district       String?  @db.VarChar(100)
  ward           String?  @db.VarChar(100)
  companyName    String?  @db.VarChar(200)
  groupId        Int?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  purchaseReceipts PurchaseReceipt[]
  purchaseReturns  PurchaseReturn[]
  group            SupplierGroup?    @relation(fields: [groupId], references: [id], onDelete: Restrict)

  @@index([name])
  @@index([isActive])
  @@index([groupId])
}

model SupplierGroup {
  id        Int        @id @default(autoincrement())
  name      String     @unique @db.VarChar(100)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  suppliers Supplier[]
}

model PurchaseReceipt {
  id                Int                   @id @default(autoincrement())
  receiptCode       String                @unique
  supplierId        Int?
  receivedAt        DateTime
  invoiceNumber     String?
  invoiceDate       DateTime?
  status            PurchaseReceiptStatus @default(DRAFT)
  subtotalAmount    Int                   @default(0)
  discountAmount    Int                   @default(0)
  paidAmount        Int                   @default(0)
  paymentMethod     PaymentMethod         @default(CASH)
  financialAccountId Int?
  note              String?               @db.VarChar(1000)
  createdByUserId   Int?
  postedByUserId    Int?
  postedAt          DateTime?
  cancelledByUserId Int?
  cancelledAt       DateTime?
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt

  supplier              Supplier?              @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  lines                 PurchaseReceiptLine[]
  purchaseReturns       PurchaseReturn[]
  inventoryTransactions InventoryTransaction[]
  cashVouchers          CashVoucher[]
  financialAccount      FinancialAccount?       @relation("PurchaseReceiptFinancialAccount", fields: [financialAccountId], references: [id], onDelete: Restrict)

  @@index([supplierId, receivedAt])
  @@index([status, receivedAt])
  @@index([financialAccountId])
}

model PurchaseReceiptLine {
  id                Int      @id @default(autoincrement())
  purchaseReceiptId Int
  ingredientId      Int
  ingredientSku     String
  ingredientName    String
  unit              String
  quantity          Float
  unitCost          Int
  discountAmount    Int      @default(0)
  note              String?  @db.VarChar(1000)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  purchaseReceipt PurchaseReceipt @relation(fields: [purchaseReceiptId], references: [id], onDelete: Cascade)
  ingredient      Ingredient      @relation(fields: [ingredientId], references: [id], onDelete: Restrict)

  purchaseReturnLines PurchaseReturnLine[]

  @@unique([purchaseReceiptId, ingredientId])
  @@index([ingredientId])
}

enum PurchaseReturnStatus {
  DRAFT
  COMPLETED
  CANCELLED
}

model PurchaseReturn {
  id                Int                  @id @default(autoincrement())
  returnCode        String               @unique
  supplierId        Int?
  sourceReceiptId   Int?
  returnedAt        DateTime             @default(now())
  status            PurchaseReturnStatus @default(DRAFT)
  version           Int                  @default(1)
  subtotalAmount    Int                  @default(0)
  discountAmount    Int                  @default(0)
  vatAmount         Int                  @default(0)
  refundAmount      Int                  @default(0)
  refundMethod      PaymentMethod        @default(CASH)
  financialAccountId Int?
  note              String?              @db.VarChar(1000)
  createdByUserId   Int?
  createdByName     String?              @db.VarChar(120)
  completedByUserId Int?
  completedAt       DateTime?
  cancelledByUserId Int?
  cancelledAt       DateTime?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  supplier              Supplier?              @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  sourceReceipt         PurchaseReceipt?       @relation(fields: [sourceReceiptId], references: [id], onDelete: Restrict)
  lines                 PurchaseReturnLine[]
  inventoryTransactions InventoryTransaction[]
  financialAccount      FinancialAccount?       @relation("PurchaseReturnFinancialAccount", fields: [financialAccountId], references: [id], onDelete: Restrict)

  @@index([status, returnedAt])
  @@index([supplierId, returnedAt])
  @@index([sourceReceiptId])
  @@index([financialAccountId])
}

model PurchaseReturnLine {
  id                  Int                  @id @default(autoincrement())
  purchaseReturnId    Int
  ingredientId        Int
  sourceReceiptLineId Int?
  ingredientSku       String
  ingredientName      String
  unit                String
  quantity            Float
  purchaseUnitCost    Int
  returnUnitPrice     Int
  lineAmount          Int
  stockCostPerUnit    Int                  @default(0)
  stockCostAmount     Int                  @default(0)
  purchaseReturn      PurchaseReturn       @relation(fields: [purchaseReturnId], references: [id], onDelete: Cascade)
  ingredient          Ingredient           @relation(fields: [ingredientId], references: [id], onDelete: Restrict)
  sourceReceiptLine   PurchaseReceiptLine? @relation(fields: [sourceReceiptLineId], references: [id], onDelete: Restrict)

  @@unique([purchaseReturnId, ingredientId])
  @@index([ingredientId])
  @@index([sourceReceiptLineId])
}
