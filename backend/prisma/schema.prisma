  orderItem OrderItem           @relation(fields: [orderItemId], references: [id], onDelete: Restrict)
  saleBasis CommissionSaleBasis @relation(fields: [saleBasisId], references: [id], onDelete: Restrict)

  @@index([status, type, lastDetectedAt])
}

model CommissionEntry {
  id                     Int                 @id @default(autoincrement())
  eventKey               String              @unique @db.VarChar(191)
  type                   CommissionEntryType
  correlationKey         String?             @db.VarChar(191)
  originalEntryId        Int?
  sourceEntryId          Int?
  saleBasisId            Int
  orderId                Int
  orderItemId            Int
  orderReturnId          Int?
  orderReturnLineId      Int?
  employeeId             Int
  commissionPlanId       Int?
  commissionRuleId       Int?
  saleBusinessDate       DateTime            @db.Date
  accountingDate         DateTime            @db.Date
  occurredAt             DateTime
  quantityDelta          Int
  grossRevenueDelta      Int
  allocatedDiscountDelta Int
  netRevenueDelta        Int
  costAmountDelta        Int
  grossProfitDelta       Int
  commissionAmountDelta  Int
  employeeSnapshot       Json
  itemSnapshot           Json
  ruleSnapshot           Json
  reason                 String?             @db.VarChar(500)
  createdByUserId        Int?
  createdByName          String?             @db.VarChar(160)
  createdAt              DateTime            @default(now())

  originalEntry   CommissionEntry?              @relation("CommissionEntryRoot", fields: [originalEntryId], references: [id], onDelete: Restrict)
  rootChildren    CommissionEntry[]             @relation("CommissionEntryRoot")
  sourceEntry     CommissionEntry?              @relation("CommissionEntrySource", fields: [sourceEntryId], references: [id], onDelete: Restrict)
  sourceChildren  CommissionEntry[]             @relation("CommissionEntrySource")
  saleBasis       CommissionSaleBasis           @relation(fields: [saleBasisId], references: [id], onDelete: Restrict)
  order           Order                         @relation(fields: [orderId], references: [id], onDelete: Restrict)
  orderItem       OrderItem                     @relation(fields: [orderItemId], references: [id], onDelete: Restrict)
  orderReturn     OrderReturn?                  @relation(fields: [orderReturnId], references: [id], onDelete: Restrict)
  orderReturnLine OrderReturnLine?              @relation(fields: [orderReturnLineId], references: [id], onDelete: Restrict)
  employee        Employee                      @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  commissionPlan  CommissionPlan?               @relation(fields: [commissionPlanId], references: [id], onDelete: Restrict)
  commissionRule  CommissionRule?               @relation(fields: [commissionRuleId], references: [id], onDelete: Restrict)
  allocations     CommissionPayrollAllocation[]

  @@unique([orderReturnLineId, type], map: "CommissionEntry_orderReturnLineId_type_key")
  @@index([originalEntryId, occurredAt])
  @@index([sourceEntryId, occurredAt])
  @@index([employeeId, accountingDate, id])
  @@index([orderItemId, occurredAt])
}

model CommissionPayrollAllocation {
  id                Int                                  @id @default(autoincrement())
  allocationKey     String                               @db.VarChar(191)
  type              CommissionPayrollAllocationEventType
  priorEventId      Int?                                 @unique
  commissionEntryId Int
  payrollBatchId    Int
  payrollLineId     Int
  allocatedAmount   Int
  reason            String?                              @db.VarChar(500)
  createdByUserId   Int?
  createdAt         DateTime                             @default(now())

  priorEvent      CommissionPayrollAllocation? @relation("CommissionAllocationChain", fields: [priorEventId], references: [id], onDelete: Restrict)
  nextEvent       CommissionPayrollAllocation? @relation("CommissionAllocationChain")
  commissionEntry CommissionEntry              @relation(fields: [commissionEntryId], references: [id], onDelete: Restrict)
  payrollBatch    EmployeePayrollBatch         @relation(fields: [payrollBatchId], references: [id], onDelete: Restrict)
  payrollLine     EmployeePayrollLine          @relation(fields: [payrollLineId], references: [id], onDelete: Restrict)

  @@index([allocationKey, createdAt])
  @@index([commissionEntryId, type])
  @@index([payrollBatchId, payrollLineId])
}

model AuditLog {
  id         Int      @id @default(autoincrement())
  action     String // MENU_ITEM_CREATED | MENU_ITEM_UPDATED | MENU_ITEM_AVAILABILITY_CHANGED | MENU_IMAGE_UPLOADED | ORDER_VOIDED
  targetType String // MenuItem | Order
  targetId   Int?
